ph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Start for free, enjoy all features, and gain access to a knowledge base and ticket support.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Target high-volume keywords in product titles \u0026 descriptions for better reach.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Quickly fill missing attributes: color, size, brand, GTINs in your product feed.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Create data rules to eliminate repetitive optimizations and boost efficiency.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Manage multiple channels with ease - optimise once and apply them everywhere.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Create custom labels based on any criteria to suit a wide range of applications.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"}],"nodeType":"document"}},"summary":{"json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Advanced Google Shopping feed optimization platform. Tailored for Google Shopping and Pmax ad managers to significantly enhance ROAS.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"rating":5,"reviewCount":8,"unifiedBilling":null,"catalystCompatible":null,"freeTrial":true,"freeTrialDays":365,"createdOn":"2020-12-17T04:02:00.000Z","appRegistryUpdatedAt":"2025-06-03T04:46:42.000Z","multiStorefront":false,"multiLocation":false,"singleClick":true,"logo":"//s3.amazonaws.com/integrated-