<script>
  function matchHeightToTallestCard(query, minHeight){
    var maxHeight = 0;

    var elements = document.querySelectorAll(query);
    elements.forEach(function(element) {
       var elementHeight = element.offsetHeight;
       if (elementHeight > maxHeight) { maxHeight = elementHeight; }
    });

    if(minHeight){
      elements.forEach(function(element) {
       element.style.minHeight = maxHeight + "px";
    });
      return
    }
    
    elements.forEach(function(element) {
       element.style.height = maxHeight + "px";
    });
  }
  
  matchHeightToTallestCard(".testimonial-card")
  matchHeightToTallestCard(".media_grid-item", true)
  
  const navBar = document.querySelector('.header_navbar.w-nav');
  window.addEventListener('scroll', function () {
    if (window.pageYOffset > 10) {
      navBar.style.backgroundColor = 'var(--indigo)';
    }else{
       navBar.style.backgroundColor = 'var(--transparent)';
    }
  });
  
</script>


<script>
  //----//gsap.registerPlugin(ScrollTrigger);

    const split = document.querySelectorAll('.reveal-text');

    split.forEach(function(string, i){
      const text =  new SplitType(string, {types: 'words'})
      console.log(text.words);

      gsap.from(
        text.words,
        {
          scrollTrigger: {
            trigger: string,
            start: 'top 80%',
            end: 'top 20%',
            scrub: false,
            markers: false
        },
        opacity: 0,
        scale: 0.97,
        stagger: 0.1,
          // duration: 1.5,
        ease: 'power1.in'
    })
  })

    

    const reveal = document.querySelectorAll('.reveal');

    reveal.forEach(function(el, i){

      gsap.from(
        el,
        {
          scrollTrigger: {
            trigger: el,
            start: 'top 70%',
            end: 'top 20%',
            scrub: false,
            markers: false,            
        },
        duration: 0.5,
        opacity: 0,
        stagger: 0.2,
        y: 0,
          // duration: 1.5,
        ease: 'power1.in'
    })
  })
</script>

