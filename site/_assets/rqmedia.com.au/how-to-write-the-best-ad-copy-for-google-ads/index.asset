<script>
  $(document).ready(function () {
    if (window.innerWidth <= 991) { // 991px is Webflow's tablet breakpoint
      $('.header_menu-dropdown_item').on('click', function () {
        $('.menu-button').trigger('tap');
      });
    }
  });
</script>
</body></html>