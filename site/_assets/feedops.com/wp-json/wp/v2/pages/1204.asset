dget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"512\" height=\"512\" viewBox=\"0 0 512 512\" fill=\"none\"><path d=\"M56.3707 307.783C61.6673 310.504 67.2299 312.673 72.9707 314.255V344.255C72.9813 344.914 73.0864 345.569 73.2827 346.199C73.823 351.097 75.6024 355.776 78.4529 359.795C81.3034 363.814 85.1311 367.041 89.5747 369.171C141.784 393.178 198.535 405.707 255.999 405.915C313.463 405.707 370.213 393.178 422.423 369.171C426.866 367.041 430.694 363.814 433.544 359.795C436.395 355.776 438.174 351.097 438.715 346.199C438.911 345.569 439.016 344.914 439.027 344.255V314.255C444.768 312.673 450.33 310.505 455.627 307.783C463.827 303.239 470.792 296.759 475.916 288.909C481.04 281.058 484.168 272.074 485.027 262.739C486.445 252.772 485.403 242.61 481.992 233.138C478.581 223.667 472.905 215.173 465.459 208.399L417.139 166.367C372.355 127.703 315.163 106.43 255.999 106.43C196.834 106.43 139.642 127.703 94.8587 166.367L46.5387 208.399C39.0922 215.173 33.4161 223.667 30.0053 233.138C26.5946 242.61 25.5528 252.772 26.9707 262.739C27.8297 272.074 30.9574 281.058 36.0815 288.909C41.2055 296.759 48.1707 303.239 56.3707 307.783ZM86.9707 335.627V307.963C142.027 292.806 198.894 285.23 255.999 285.447C313.103 285.233 369.97 292.808 425.027 307.963V335.627C369.297 325.153 312.704 319.953 255.999 320.095C199.293 319.953 142.701 325.153 86.9707 335.627ZM425.027 293.359C369.913 278.549 313.066 271.18 255.999 271.447C198.931 271.178 142.084 278.547 86.9707 293.359V288.511C141.395 270 198.513 260.644 255.999 260.823C313.485 260.644 370.602 270 425.027 288.511V293.359ZM416.431 356.519C366.1 379.655 311.392 391.725 255.999 391.915C200.605 391.725 145.897 379.655 95.5667 356.519C92.5215 355.071 90.0589 352.63 88.5827 349.599C143.768 339.122 199.827 333.93 255.999 334.095C312.17 333.93 368.229 339.122 423.415 349.599C421.938 352.63 419.476 355.07