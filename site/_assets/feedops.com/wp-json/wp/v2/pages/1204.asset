div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2756758 elementor-widget elementor-widget-image\" data-id=\"2756758\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"480\" height=\"92\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/LocaliQ_new_logo.jpg\" class=\"attachment-full size-full wp-image-4813\" alt=\"\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/LocaliQ_new_logo.jpg 480w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/LocaliQ_new_logo-300x58.jpg 300w\" sizes=\"(max-width: 480px) 100vw, 480px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8f5b20b elementor-widget elementor-widget-image\" data-id=\"8f5b20b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"168\" height=\"68\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/thryv-main-logo-color-au.png\" class=\"attachment-full size-full wp-image-4814\" alt=\"\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-3988173 e-flex e-con-boxed e-con e-parent\" data-id=\"3988173\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-f9bd4a5 elementor-pagination-type-bullets elementor-arrows-position-inside elementor-pagination-position-outside elementor-widget elementor-widget-n-carousel\" data-id=\"f9bd4a5\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;carousel_items&quot;:[{&quot;slide_title&quot;:&quot;\\u00a0- Taylor Murray - Head of Digital Transformation - Amart&quot;,&quot;_id&quot;:&quot;c547ead&quot;},{&quot;slide_title&quot;:&quot;RQMedia&quot;,&quot;_id&quot;:&quot;c7032d0&quot;},{&quot;slide_title&quot;:&quot;Kristy Thomas&quot;,&quot;_id&quot;:&quot;5b4408c&quot;},{&quot;slide_title&quot;:&quot;Karim Saykali, WeBrandIt.co.uk&quot;,&quot;_id&quot;:&quot;9a79223&quot;}],&quot;slides_to_show&quot;:&quot;1&quot;,&quot;slides_to_show_tablet&quot;:&quot;2&quot;,&quot;slides_to_show_mobile&quot;:&quot;1&quot;,&quot;autoplay&quot;:&quot;yes&quot;,&quot;autoplay_speed&quot;:5000,&quot;pause_on_hover&quot;:&quot;yes&quot;,&quot;pause_on_interaction&quot;:&quot;yes&quot;,&quot;infinite&quot;:&quot;yes&quot;,&quot;speed&quot;:500,&quot;offset_sides&quot;:&quot;none&quot;,&quot;arrows&quot;:&quot;yes&quot;,&quot;pagination&quot;:&quot;bullets&quot;,&quot;image_spacing_custom&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:10,&quot;sizes&quot;:[]},&quot;image_spacing_custom_laptop&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;image_spacing_custom_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;image_spacing_custom_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]}}\" data-widget_type=\"nested-carousel.default\">\n\t\t\t\t\t\t\t<div class=\"e-n-carousel swiper\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Carousel\" dir=\"ltr\">\n\t\t\t<div class=\"swiper-wrapper\" aria-live=\"off\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"1\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"1 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-98d3ac3 e-flex e-con-boxed e-con e-child\" data-id=\"98d3ac3\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a96bf35 elementor-widget elementor-widget-heading\" data-id=\"a96bf35\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\"FeedOps AI title optimisation delivered outstanding results in just 5 weeks\u2014organic clicks nearly doubled (+96.57%) on optimised SKUs and rose 51.16% even on non-AI titles. The AI outperformed our manual templates, proving they are a critical tool for driving organic growth without extra budget. The FeedOps team\u2019s expert guidance made implementation straightforward and seamless, and we\u2019re now rolling it out across our full catalogue to maximise results.\"<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c6fa40d e-con-full e-flex e-con e-child\" data-id=\"c6fa40d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-4ed338a e-con-full e-flex e-con e-child\" data-id=\"4ed338a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-393cb5a elementor-widget elementor-widget-image\" data-id=\"393cb5a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"400\" height=\"400\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart-.png\" class=\"attachment-large size-large wp-image-5183\" alt=\"Taylor Murray - Head of Digital Transformation - Amart\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart-.png 400w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart--300x300.png 300w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart--150x150.png 150w\" sizes=\"(max-width: 400px) 100vw, 400px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b4c02f8 elementor-widget-laptop__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"b4c02f8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u00a0&#8211; Taylor Murray\u00a0<\/i><\/strong><\/span><\/p><p><strong><i> Head of Digital Transformation, Amart<\/i><\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"2\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"2 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-57f6a23 e-flex e-con-boxed e-con e-child\" data-id=\"57f6a23\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6fc580a elementor-widget elementor-widget-heading\" data-id=\"6fc580a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\u201cAfter using FeedOps\u2019 Natural Language Titles on Speedo Australia, non-branded search terms rose 33%, impressions jumped 18%, and clicks increased 11%.\u201d<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-ab1fc49 e-con-full e-flex e-con e-child\" data-id=\"ab1fc49\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-ae351ce e-con-full e-flex e-con e-child\" data-id=\"ae351ce\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-abb8ad7 elementor-widget elementor-widget-image\" data-id=\"abb8ad7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"1000\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2.webp\" class=\"attachment-large size-large wp-image-5132\" alt=\"Hamish Becker, Account Director, RQMedia\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2.webp 800w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2-240x300.webp 240w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2-768x960.webp 768w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-97431fb elementor-widget elementor-widget-text-editor\" data-id=\"97431fb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u2013 Hamish Becker<\/i><\/strong><\/span><\/p><p><strong><i> Account Director, RQMedia<\/i><\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"3\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"3 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-e512b9e e-flex e-con-boxed e-con e-child\" data-id=\"e512b9e\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-407f5fe elementor-widget elementor-widget-heading\" data-id=\"407f5fe\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\"Since onboarding FeedOps, we've seen a huge lift in Organic Shopping performance. In just one month, revenue from this channel jumped by 139%. I\u2019m excited to see how far we can take this.\"<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-5251461 e-con-full e-flex e-con e-child\" data-id=\"5251461\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-f14835b e-con-full e-flex e-con e-child\" data-id=\"f14835b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-74ddb21 elementor-widget elementor-widget-image\" data-id=\"74ddb21\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"200\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Kristy-Thomas-Head-of-Marketing-Customer-Engagement-.jpeg\" class=\"attachment-large size-large wp-image-5134\" alt=\"Kristy Thomas Head of Marketing &amp; Customer Engagement\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Kristy-Thomas-Head-of-Marketing-Customer-Engagement-.jpeg 200w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Kristy-Thomas-Head-of-Marketing-Customer-Engagement--150x150.jpeg 150w\" sizes=\"(max-width: 200px) 100vw, 200px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-672e5c4 elementor-widget-laptop__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"672e5c4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u00a0&#8211; Kristy Thomas<\/i><\/strong><\/span><\/p><p><strong><i> Head of Marketing &amp; Customer Engagement, Auto One<\/i><\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"4\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"4 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-710f330 e-flex e-con-boxed e-con e-child\" data-id=\"710f330\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-34592a6 elementor-widget elementor-widget-heading\" data-id=\"34592a6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\u201cFeedOps didn\u2019t just optimise our product data \u2014 they helped us align it with our Google Ads strategy. Within a week, we saw a 400% increase in conversions. The impact was immediate and measurable.\u201d<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-b1a1a12 e-con-full e-flex e-con e-child\" data-id=\"b1a1a12\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-36d9e37 e-con-full e-flex e-con e-child\" data-id=\"36d9e37\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6294c44 elementor-widget elementor-widget-image\" data-id=\"6294c44\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"190\" height=\"190\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2026\/04\/Karim-Saykali.jpeg\" class=\"attachment-large size-large wp-image-5742\" alt=\"\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2026\/04\/Karim-Saykali.jpeg 190w, https:\/\/feedops.com\/wp-content\/uploads\/2026\/04\/Karim-Saykali-150x150.jpeg 150w\" sizes=\"(max-width: 190px) 100vw, 190px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-665e917 elementor-widget-laptop__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"665e917\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u00a0&#8211; Karim Saykali,<\/i><\/strong><\/span><\/p><p><span style=\"color: #000000;\"><strong><i>WeBrandIt.co.uk<\/i><\/strong><\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-prev\" role=\"button\" tabindex=\"0\" aria-label=\"Previous\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-left\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-next\" role=\"button\" tabindex=\"0\" aria-label=\"Next\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-right\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 8