{"id":1204,"date":"2023-01-23T07:34:12","date_gmt":"2023-01-22T22:04:12","guid":{"rendered":"https:\/\/feedops.com\/?page_id=1204"},"modified":"2026-04-20T11:16:21","modified_gmt":"2026-04-20T01:46:21","slug":"pricing","status":"publish","type":"page","link":"https:\/\/feedops.com\/pricing\/","title":{"rendered":"Pricing"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"1204\" class=\"elementor elementor-1204\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7416b4e e-flex e-con-boxed e-con e-parent\" data-id=\"7416b4e\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8309cab elementor-widget elementor-widget-image\" data-id=\"8309cab\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"800\" height=\"245\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/feedops-ai-powered-software-white-glove-support-1-1024x314.png\" class=\"attachment-large size-large wp-image-5070\" alt=\"FeedOps AI-powered software with white glove support banner\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/feedops-ai-powered-software-white-glove-support-1-1024x314.png 1024w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/feedops-ai-powered-software-white-glove-support-1-300x92.png 300w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/feedops-ai-powered-software-white-glove-support-1-768x236.png 768w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/feedops-ai-powered-software-white-glove-support-1-1536x472.png 1536w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/feedops-ai-powered-software-white-glove-support-1-2048x629.png 2048w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-35bc7b5 elementor-widget elementor-widget-heading\" data-id=\"35bc7b5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">FeedOps Pricing That Just Makes Sense<\/h1>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-061a1cd elementor-widget elementor-widget-text-editor\" data-id=\"061a1cd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p style=\"text-align: center;\"><b>Enterprise-Grade Feed Optimization.\u00a0<\/b><span style=\"font-weight: 400;\">Accessible &amp; Flexible. Proven to Increase Ad revenue in 30 days, without increasing ad spend. Every plan includes AI-powered optimization and white-glove support to help you drive more sales with less spend. <\/span><b>Plans from <span class=\"dynmic-pricing\">$550\/month (AUD)<\/span> &#8211;\u00a0<\/b><span style=\"font-weight: 400;\">Get started with a live demo using your own product data\u2014see what optimized product data looks like, then launch a 30-day pilot to prove the results.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5ffe838 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"5ffe838\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/book-live-demo\/\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Request a Live Demo<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-0b43be0 e-flex e-con-boxed e-con e-parent\" data-id=\"0b43be0\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-fda17cd elementor-widget__width-initial elementor-widget elementor-widget-heading\" data-id=\"fda17cd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Compare Plans \u2013 All-Inclusive, Expert-Managed\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-19a34c6 elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"19a34c6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Every plan includes full-service feed optimization powered by AI and backed by our expert team. Choose the level that fits your channel mix, complexity, and growth goals.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-980440d e-con-full e-flex e-con e-child\" data-id=\"980440d\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;gradient&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-ccc4bf5 e-con-full e-flex e-con e-child\" data-id=\"ccc4bf5\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-90abe5b e-con-full e-flex e-con e-child\" data-id=\"90abe5b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5df6941 elementor-widget elementor-widget-heading\" data-id=\"5df6941\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">Not sure where to start?<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-381cdd5 e-con-full e-flex e-con e-child\" data-id=\"381cdd5\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-fefa8dd e-con-full e-flex e-con e-child\" data-id=\"fefa8dd\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3e5de3f elementor-widget elementor-widget-heading\" data-id=\"3e5de3f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">Essentials<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4242690 e-con-full e-flex e-con e-child\" data-id=\"4242690\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4261f47 elementor-widget elementor-widget-heading\" data-id=\"4261f47\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">For core ad channels (Google, Microsoft &amp; Meta)<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-8ae580a e-con-full e-flex e-con e-child\" data-id=\"8ae580a\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-9c9ac1f e-con-full e-flex e-con e-child\" data-id=\"9c9ac1f\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-616bf6e elementor-widget elementor-widget-heading\" data-id=\"616bf6e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">Plus<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-3d2f698 e-con-full e-flex e-con e-child\" data-id=\"3d2f698\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5cfe100 elementor-widget elementor-widget-heading\" data-id=\"5cfe100\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\"> Extended social, LIA, and affiliate expansion\n<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-0463112 e-con-full e-flex e-con e-child\" data-id=\"0463112\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-999d8f3 e-con-full e-flex e-con e-child\" data-id=\"999d8f3\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-cff872a elementor-widget elementor-widget-heading\" data-id=\"cff872a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">Complete<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-d9f3391 e-con-full e-flex e-con e-child\" data-id=\"d9f3391\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-2f89087 elementor-widget elementor-widget-heading\" data-id=\"2f89087\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">Also included marketplaces\n<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-db6fbc5 e-con-full e-flex e-con e-child\" data-id=\"db6fbc5\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-f1af7b2 e-con-full e-flex e-con e-child\" data-id=\"f1af7b2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-0b29184 elementor-widget elementor-widget-heading\" data-id=\"0b29184\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">VIP<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-2e9f05a e-con-full e-flex e-con e-child\" data-id=\"2e9f05a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7a7330b elementor-widget elementor-widget-heading\" data-id=\"7a7330b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h5 class=\"elementor-heading-title elementor-size-default\">Invite-only for enterprise-scale partnerships\n<\/h5>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4e4fcb4 e-flex e-con-boxed e-con e-parent\" data-id=\"4e4fcb4\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-183b08d elementor-widget elementor-widget-html\" data-id=\"183b08d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<style>\n  :root {\n    --bg: #f7faff;\n    --card: #ffffff;\n    --muted: #51607a;\n    --text: #0f172a;\n    --accent: #0284c7;\n    --accent-2: #6d28d9;\n    --success: #34d399;\n    --warning: #fbbf24;\n    --ring: rgba(2, 132, 199, 0.2);\n    --border: #e6ebf4;\n    --chip: #f1f5f9;\n    --shadow: 0 8px 24px rgba(2, 6, 23, 0.08);\n    --radius-xl: 22px;\n    --radius-lg: 14px;\n  }\n\n  .container {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 48px 20px 80px;\n  }\n\n  .eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-weight: 600;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    font-size: 12px;\n    padding: 6px 12px;\n    border-radius: 999px;\n    color: var(--accent);\n    background: rgba(2, 132, 199, 0.1);\n    border: 1px solid rgba(2, 132, 199, 0.22);\n  }\n\n  .lead {\n    color: var(--muted);\n    max-width: 68ch;\n    margin: 6px 0 36px;\n  }\n\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 22px;\n  }\n  @media (max-width: 980px) {\n    .grid {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  .card {\n    position: relative;\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-xl);\n    box-shadow: var(--shadow);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    min-height: 100%;\n  }\n\n  .badge {\n    background: #fecf26;\n    color: #000000;\n    position: absolute;\n    display: block;\n    top: 18px;\n    right: -30px;\n    width: 128px;\n    font-size: 14px !important;\n    font-weight: 800;\n    text-align: center;\n    padding: 3px 20px 8px;\n    margin: 0;\n    transform: rotate(45deg);\n    height: 32px;\n    z-index: 2;\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    box-sizing: border-box;\n  }\n\n  .card header {\n    padding: 24px 22px 8px;\n  }\n  .kicker {\n    color: var(--muted);\n    font-weight: 600;\n    font-size: 13px;\n  }\n  .title {\n    font-size: 20px !important;\n    font-weight: 800 !important;\n    margin: 6px 0;\n  }\n  .subtitle {\n    color: var(--muted);\n    margin: 0 0 14px;\n    font-size: 14px !important;\n  }\n\n  .section {\n    padding: 2px 22px 18px;\n  }\n  .section h3 {\n    font-size: 13px;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--muted);\n    margin: 12px 0 8px;\n  }\n\n  ul.feature-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: grid;\n    gap: 10px;\n  }\n  .feature-list li {\n    display: grid;\n    grid-template-columns: 22px 1fr;\n    align-items: c;\n    gap: 10px;\n    font-size: 15px;\n  }\n\n  .check {\n    width: 18px;\n    height: 18px;\n    border-radius: 2px;\n    flex: none;\n    display: inline-grid;\n    place-items: center;\n    background: rgba(52, 211, 153, 0.12);\n    border: 1px solid rgba(52, 211, 153, 0.35);\n  }\n\n  .foot {\n    margin-top: auto;\n    padding: 18px 22px 22px;\n    border-top: 1px dashed var(--border);\n    display: grid;\n    gap: 12px;\n  }\n  .price {\n    font-size: 14px;\n    color: var(--muted);\n  }\n  .price strong {\n    color: var(--text);\n    font-size: 18px;\n  }\n\n  .btn {\n    appearance: none;\n    border: 1px solid var(--border);\n    background: var(--chip);\n    color: var(--text);\n    padding: 10px 14px;\n    border-radius: 12px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n  .btn-primary {\n    background: linear-gradient(\n      180deg,\n      rgba(2, 132, 199, 0.12),\n      rgba(2, 132, 199, 0.04)\n    );\n    border-color: var(--ring);\n  }\n\n  .compare {\n    margin-top: 56px;\n    border: 1px solid var(--border);\n    background: var(--card);\n    border-radius: var(--radius-xl);\n    overflow: hidden;\n    box-shadow: var(--shadow);\n  }\n  .compare-head {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 1px;\n    background: var(--border);\n  }\n  .head-cell {\n    background: var(--card);\n    padding: 22px;\n    text-align: center;\n  }\n  .head-cell h2 {\n    margin: 0;\n    font-size: 26px;\n    font-weight: 800;\n  }\n  .head-cell p {\n    margin: 6px auto 0;\n    color: var(--muted);\n    max-width: 38ch;\n  }\n\n  .compare-body {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n  .cell {\n    padding: 14px 18px;\n    border-top: 1px solid var(--border);\n  }\n  .cell:nth-child(odd) {\n    background: rgba(2, 132, 199, 0.02);\n  }\n\n  @media (max-width: 820px) {\n    .compare-head,\n    .compare-body {\n      grid-template-columns: 1fr;\n    }\n    .head-cell {\n      text-align: left;\n    }\n  }\n\n  .chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid var(--border);\n    background: var(--chip);\n    color: var(--muted);\n    padding: 6px 10px;\n    border-radius: 999px;\n    font-size: 12px;\n  }\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n  }\n  .elementor-button {\n    background-color: #ffcf26;\n  }\n  .elementor-button-text {\n    color: black !important;\n    font-weight: 600;\n  }\n<\/style>\n<main class=\"container\">\n  <section class=\"grid\" aria-label=\"Pricing tiers\">\n    <!-- Essentials -->\n    <article class=\"card\" aria-labelledby=\"essentials-title\">\n      <div class=\"badge\">Pilot Ready<\/div>\n      <header>\n        <div class=\"kicker\">For brands focused on core ad channels<\/div>\n        <h2 id=\"essentials-title\" class=\"title\">White\u2011Glove Essentials<\/h2>\n        <p class=\"subtitle\">Get started with powerful fundamentals.<\/p>\n      <\/header>\n\n      <div class=\"section\">\n        <h3>What's Included<\/h3>\n        <ul class=\"feature-list\">\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span\n              >Fully managed product feeds for Google, Microsoft, Meta, and\n              Pinterest<\/span\n            >\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span\n              >AI optimization for <strong>1,000 SKUs\/month<\/strong> (more\n              available as an add\u2011on)<\/span\n            >\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span>Bulk product data editing and enrichment<\/span>\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span>Feed rules, templates, and custom labels<\/span>\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span\n              >Global\u2011ready feeds with local currencies and shipping logic<\/span\n            >\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span\n              >Auto\u2011syncs price and availability changes to all connected\n              platforms*<\/span\n            >\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span>Unlimited users and SKU sync<\/span>\n          <\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"section\">\n        <h3>Support &amp; Access<\/h3>\n        <ul class=\"feature-list\">\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span>Priority email support<\/span>\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span>Direct access to a FeedOps feed specialist<\/span>\n          <\/li>\n        <\/ul>\n      <\/div>\n\n      <footer class=\"foot\">\n        <div class=\"price\">\n          <span class=\"sr-only\">Price: <\/span>Starts at\n          <strong class=\"price-table-amount\" >$550\/month AUD<\/strong>\n        <\/div>\n        <div class=\"actions\">\n          <div\n            class=\"elementor-element elementor-element-9feb916 elementor-align-left elementor-widget elementor-widget-button\"\n            data-id=\"9feb916\"\n            data-element_type=\"widget\"\n            data-widget_type=\"button.default\"\n          >\n            <a\n              class=\"elementor-button elementor-button-link elementor-size-sm\"\n              href=\"\/book-live-demo\/\"\n              target=\"_blank\"\n            >\n              <span class=\"elementor-button-content-wrapper\">\n                <span class=\"elementor-button-text\">Request a Live Demo<\/span>\n              <\/span>\n            <\/a>\n          <\/div>\n        <\/div>\n      <\/footer>\n    <\/article>\n\n    <!-- Plus -->\n    <article class=\"card\" aria-labelledby=\"plus-title\">\n      <header>\n        <div class=\"kicker\">For brands scaling beyond ads<\/div>\n        <h2 id=\"plus-title\" class=\"title\">White\u2011Glove Plus<\/h2>\n        <p class=\"subtitle\">Expand into in\u2011store and affiliate channels.<\/p>\n      <\/header>\n\n      <div class=\"section\">\n        <h3>What's Included<\/h3>\n        <ul class=\"feature-list\">\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span\n              >Fully managed product feeds for Google, Microsoft, Meta,\n              Pinterest<br \/>\n              + TikTok, Criteo, affiliate &amp; email channels >\n              <br \/>\n              + Local inventory &amp; local area feeds<\/span\n            >\n          <\/li>\n          <li>\n            <span class=\"check\" aria-hidden=\"true\">\u27a4<\/span\n            ><span\n              >AI optimization for <strong>2,000 SKUs\/month<\/strong> (more\n              available as an add\u2011on)<\/span\n            >\n          <\/li>\n          <li>\n            <s