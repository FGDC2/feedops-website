{"id":3660,"date":"2024-07-19T15:32:33","date_gmt":"2024-07-19T06:02:33","guid":{"rendered":"https:\/\/feedops.com\/?page_id=3660"},"modified":"2026-04-20T09:45:09","modified_gmt":"2026-04-20T00:15:09","slug":"home-page","status":"publish","type":"page","link":"https:\/\/feedops.com\/","title":{"rendered":"Home Page"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"3660\" class=\"elementor elementor-3660\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9e017b5 e-flex e-con-boxed e-con e-parent\" data-id=\"9e017b5\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;gradient&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-1b30348 e-con-full e-flex e-con e-child\" data-id=\"1b30348\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-1291d36 e-con-full e-flex e-con e-child\" data-id=\"1291d36\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-2b102a3 e-con-full e-flex e-con e-child\" data-id=\"2b102a3\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-df3eff7 e-con-full e-flex e-con e-child\" data-id=\"df3eff7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ff1781a elementor-widget elementor-widget-heading\" data-id=\"ff1781a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">More sales, less spend.<\/p>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f167d16 elementor-widget elementor-widget-heading\" data-id=\"f167d16\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Maximize Your Sales with AI Product Feed Optimization.<\/h1>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-dc6c053 elementor-widget elementor-widget-heading\" data-id=\"dc6c053\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">FeedOps is a platform that helps <b>retailers<\/b>, <b>marketers<\/b>, and <b>agencies<\/b> grow online and in\u2011store sales with AI\u2011powered product\u2011feed optimization. It drives smarter ads and better marketplace performance\u2014reducing wasted spend and boosting ROI.\n<\/h2>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-dd79fcd e-con-full e-flex e-con e-child\" data-id=\"dd79fcd\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9feb916 elementor-align-left elementor-mobile-align-justify elementor-widget elementor-widget-button\" data-id=\"9feb916\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/book-live-demo\/\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Request a Live Demo <\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f14785a elementor-align-left elementor-mobile-align-center elementor-widget elementor-widget-button\" data-id=\"f14785a\" data-element_type=\"widget\" data-e-type=\"widget\" id=\"open-video-modal\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/free-google-shopping-feed-audit\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Run a Free Automated Feed Audit<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-0f25cc4 e-con-full e-flex e-con e-child\" data-id=\"0f25cc4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ed556e3 elementor-hidden-mobile elementor-widget elementor-widget-text-editor\" data-id=\"ed556e3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>Our <b>organic shopping revenue soared by 139% <\/b>in just one month\u00a0<span style=\"background-color: transparent; font-size: 1rem;\">\u2014\u00a0<\/span><span style=\"background-color: transparent;\">Kristy Thomas,\u00a0<\/span><span style=\"background-color: transparent; font-size: 1rem;\">Head of Marketing &amp; Customer Engagement (Auto One)<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-d085516 e-con-full e-flex e-con e-child\" data-id=\"d085516\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-72507aa elementor-widget elementor-widget-video\" data-id=\"72507aa\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;video_type&quot;:&quot;hosted&quot;,&quot;autoplay&quot;:&quot;yes&quot;,&quot;mute&quot;:&quot;yes&quot;,&quot;loop&quot;:&quot;yes&quot;,&quot;play_on_mobile&quot;:&quot;yes&quot;}\" data-widget_type=\"video.default\">\n\t\t\t\t\t\t\t<div class=\"e-hosted-video elementor-wrapper elementor-open-inline\">\n\t\t\t\t\t<video class=\"elementor-video\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/landing-page-video.mp4\" autoplay=\"\" loop=\"\" muted=\"muted\" playsinline=\"\" controlsList=\"nodownload\" poster=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/ai-product-feed-optimization.png\"><\/video>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-eb986a8 e-con-full e-flex e-con e-child\" data-id=\"eb986a8\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-fc932a3 e-grid e-con-full e-con e-child\" data-id=\"fc932a3\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-54b3603 elementor-widget elementor-widget-image\" data-id=\"54b3603\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"800\" height=\"316\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/google-logo-2-1024x405.png\" class=\"attachment-large size-large wp-image-4711\" alt=\"\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/google-logo-2-1024x405.png 1024w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/google-logo-2-300x119.png 300w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/google-logo-2-768x304.png 768w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/google-logo-2-1536x607.png 1536w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/google-logo-2-2048x809.png 2048w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8bd9175 elementor-widget elementor-widget-image\" data-id=\"8bd9175\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"800\" height=\"316\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2