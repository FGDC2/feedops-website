entor-widget elementor-widget-text-editor\" data-id=\"6f43a04\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">No more data errors, disapprovals, or marketplace mismatches. We handle the messy middle so your team can focus on what it does best.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-b881582 e-con-full e-flex e-con e-child\" data-id=\"b881582\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-f39b498 elementor-view-stacked elementor-shape-rounded elementor-widget elementor-widget-icon\" data-id=\"f39b498\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"512\" height=\"512\" viewBox=\"0 0 512 512\" fill=\"none\"><path d=\"M288 96H232C229.878 96 227.843 96.8429 226.343 98.3431C224.843 99.8434 224 101.878 224 104C224 106.122 224.843 108.157 226.343 109.657C227.843 111.157 229.878 112 232 112H288C290.122 112 292.157 111.157 293.657 109.657C295.157 108.157 296 106.122 296 104C296 101.878 295.157 99.8434 293.657 98.3431C292.157 96.8429 290.122 96 288 96ZM328 96H320C317.878 96 315.843 96.8429 314.343 98.3431C312.843 99.8434 312 101.878 312 104C312 106.122 312.843 108.157 314.343 109.657C315.843 111.157 317.878 112 320 112H328C330.122 112 332.157 111.157 333.657 109.657C335.157 108.157 336 106.122 336 104C336 101.878 335.157 99.8434 333.657 98.3431C332.157 96.8429 330.122 96 328 96ZM368 96H360C357.878 96 355.843 96.8429 354.343 98.3431C352.843 99.8434 352 101.878 352 104C352 106.122 352.843 108.157 354.343 109.657C355.843 111.157 357.878 112 360 112H368C370.122 112 372.157 111.15