 Supplemental Feeds - How & When To Use Them\",\"isPartOf\":{\"@id\":\"https:\/\/feedops.com\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\/\/feedops.com\/merchant-center-supplemental-feed-how-when-to-use-them\/#primaryimage\"},\"image\":{\"@id\":\"https:\/\/feedops.com\/merchant-center-supplemental-feed-how-when-to-use-them\/#primaryimage\"},\"thumbnailUrl\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60efc558290a96e7b30114ab_abc.png\",\"datePublished\":\"2020-01-04T14:30:03+00:00\",\"dateModified\":\"2022-08-10T07:38:42+00:00\",\"breadcrumb\":{\"@id\":\"https:\/\/feedops.com\/merchant-center-supplemental-feed-how-when-to-use-them\/#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\/\/feedops.com\/merchant-center-supplemental-feed-how-when-to-use-them\/\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\/\/feedops.com\/merchant-center-supplemental-feed-how-when-to-use-them\/#primaryimage\",\"url\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60efc558290a96e7b30114ab_abc.png\",\"contentUrl\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60efc558290a96e7b30114ab_abc.png\",\"width\":987,\"height\":660},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\/\/feedops.com\/merchant-center-supplemental-feed-how-when-to-use-them\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\/\/feedops.com\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Merchant Center Supplemental Feeds &#8211; How &#038; When To Use Them\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\/\/feedops.com\/#website\",\"url\":\"https:\/\/feedops.com\/\",\"name\":\"FeedOps\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\/\/feedops.com\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\/\/feedops.com\/?s={search_term_string}\"},\"query-input\":{\"@t