entialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\/\/feedops.com\/google-ads-data-that-will-improve-your-revenue\/\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\/\/feedops.com\/google-ads-data-that-will-improve-your-revenue\/#primaryimage\",\"url\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60ebd46ac77cea3b089d1507_stephen-dawson-qwtCeJ5cLYs-unsplash-1536x1105-1.jpeg\",\"contentUrl\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60ebd46ac77cea3b089d1507_stephen-dawson-qwtCeJ5cLYs-unsplash-1536x1105-1.jpeg\",\"width\":1536,\"height\":1105},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\/\/feedops.com\/google-ads-data-that-will-improve-your-revenue\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\/\/feedops.com\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Google Ads Data That Will Improve Your Revenue\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\/\/feedops.com\/#website\",\"url\":\"https:\/\/feedops.com\/\",\"name\":\"FeedOps\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\/\/feedops.com\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\/\/feedops.com\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\/\/feedops.com\/#organization\",\"name\":\"FeedOps\",\"url\":\"https:\/\/feedops.com\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\/\/feedops.com\/#\/schema\/logo\/image\/\",\"url\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png\",\"contentUrl\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png\",\"width\":899,\"height\":929,\"caption\":\