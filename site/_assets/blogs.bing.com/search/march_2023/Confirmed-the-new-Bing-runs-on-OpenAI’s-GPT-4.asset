    <script type='text/javascript' src='/Scripts/skip-link-focus-fix.js'></script>
    <script type='text/javascript' src='/Scripts/bing-main.js?v=5eFSDJsvxMO7UGi-ppputbMMUtsUEGlFRnitF8vxBgA'></script>
    <script type='text/javascript' src='/Scripts/mobile-menu.js'></script>
    <script type='text/javascript' src='/Scripts/jquery.bxslider.js'></script>
    <script type='text/javascript' src='/Scripts/home.js'></script>

    <script type='text/javascript'>
        const currentUrl = window.location.href;
        const currentUrlWithoutQuerystring = currentUrl.split('?')[0];
        const currentUrlPath = currentUrlWithoutQuerystring.replace(/^https?:\/\//, '').replace(/\/$/, '').split('/');

        let baseUrl = '';
        let subUrl = ''
        
        if (currentUrlPath.length > 1 && currentUrlPath[1] == '404') {
            subUrl = '/home/search';
        }
        else if (currentUrlPath.length > 1) {
            subUrl = '/' + currentUrlPath[1] + '/search';
        }
        else {
            subUrl = '/home/search';
        }

        let searchBaseUrl = baseUrl + subUrl;
        $(document).ready(function () {
            // There could be multiple forms
            $(".search-form").each(function (index, element) {
                let form$ = $(element);
                
                // Function to perform search
                function performSearch(e) {
                    e.preventDefault();
                    let searchInput = form$.find(".search-field").val();
                    let searchUrl = searchBaseUrl + "?searchtext=" + encodeURIComponent(searchInput);
                    window.location.href = searchUrl;
                }
                
                // Handle search button click
                form$.find(".search-submit").on("click", performSearch);
                
                // Handle Enter key press on search field
                form$.find(".search-field").on("keypress", function (e) {
                    if (e.which === 13) { // Enter key
                        performSearch(e);
                    }
                });
            });
        });

    </script>

    <script type="text/javascript">
        var consent = siteConsent.getConsent();
        if (consent.SocialMedia) {
            loadSocial(addTabIndex);
        }

        function loadSocial(callback) { 
            document.write("<script type='text/javascript' src='//platform-api.sharethis.com/js/sharethis.js#property=65aed4fe1d58d500121373dc&product=sticky-share-buttons' async = 'async'><\/script>");
            callback();
        }

        function addTabIndex() {
            setTimeout(function () {
                var buttons = document.getElementsByClassName('st-btn');
                for (const btn of buttons) {
                    btn.setAttribute('tabindex', '0');
                    btn.setAttribute('role', 'button');
                }
                document.querySelectorAll(".st-btn").forEach(btn => {
                    btn.addEventListener("keydown", (e) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            btn.click(); // simulate mouse click
                        }
                    });
                });
            }, 1500);
        }

        document.addEventListener("DOMContentLoaded", () => {
            const makeGIFInteractive = (el) => {
                el.setAttribute("tabindex", "0");
                el.setAttribute("role", "button");
                el.setAttribute("data-gif-enhanced", "true");

                // Default state: playing
                el.dataset.state = "playing";
                el.setAttribute("data-state", "playing");
                el.setAttribute("aria-pressed", "true");
                el.setAttribute("aria-label", "Pause GIF animation");

                const pauseGIF = (img) => {
                    const placeholder = document.createElement("div");
                    placeholder.style.width = img.width + "px";
                    placeholder.style.height = img.height + "px";
                    placeholder.style.background = "#ccc center/cover no-repeat";
                    placeholder.innerText = "GIF animation paused";
                    placeholder.setAttribute("tabindex", "0");
                    placeholder.setAttribute("role", "button");
                    placeholder.setAttribute("class", "image-placeholder");

                    // ARIA for paused state
                    placeholder.dataset.state = "paused";
                    placeholder.setAttribute("aria-pressed", "false");
                    placeholder.setAttribute("aria-label", "Resume GIF animation");

                    placeholder.addEventListener("click", () => resumeGIF(img, placeholder));
                    placeholder.addEventListener("keydown", (e) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            resumeGIF(img, placeholder);
                        }
                    });

                    img.replaceWith(placeholder);
                    placeholder.focus();
                };

                const resumeGIF = (oldImg, placeholder) => {
                    const newImg = oldImg.cloneNode(true); // reload to restart animation
                    placeholder.replaceWith(newImg);
                    makeGIFInteractive(newImg); // re-enhance the fresh element
                    newImg.focus();
                };

                const toggle = (e) => {
                    console.log('toggle');
                    if (el.dataset.state === "playing") {
                        el.dataset.state = "paused";
                        pauseGIF(el);
                    }
                    // no explicit else — resume handled by placeholder
                };

                el.addEventListener("click", toggle);
                el.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        toggle();
                    }
                });
            };

            document
                .querySelectorAll("img[src*='.gif']")
                .forEach(makeGIFInteractive);
        });




    </script>
