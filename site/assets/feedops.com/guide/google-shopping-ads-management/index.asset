			<div class="elementor-element elementor-element-5e2074f e-flex e-con-boxed e-con e-parent" data-id="5e2074f" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-027368c e-con-full e-flex e-con e-child" data-id="027368c" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-5cddde0 elementor-widget elementor-widget-image" data-id="5cddde0" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
																<a href="https://feedops.com">
							<img loading="lazy" width="1513" height="553" src="https://feedops.com/wp-content/uploads/2022/12/Feedops-logo-Final-2-4.png" class="attachment-full size-full wp-image-4689" alt="FeedOps Logo" srcset="https://feedops.com/wp-content/uploads/2022/12/Feedops-logo-Final-2-4.png 1513w, https://feedops.com/wp-content/uploads/2022/12/Feedops-logo-Final-2-4-300x110.png 300w, https://feedops.com/wp-content/uploads/2022/12/Feedops-logo-Final-2-4-1024x374.png 1024w, https://feedops.com/wp-content/uploads/2022/12/Feedops-logo-Final-2-4-768x281.png 768w" sizes="(max-width: 1513px) 100vw, 1513px" />								</a>
