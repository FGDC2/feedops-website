	<item>
		<title>Google Local Inventory Ads Performance Max Guide</title>
		<link>https://feedops.com/guide/google-local-inventory-ads-performance-max/</link>
		
		<dc:creator><![CDATA[Jazib Zaidi]]></dc:creator>
