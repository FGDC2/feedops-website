a6e1a92810442ca0c467eb?s=96&d=mm&r=g\",\"contentUrl\":\"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g\",\"caption\":\"FeedOps\"},\"sameAs\":[\"https:\/\/feedops.com\"],\"url\":\"https:\/\/feedops.com\/author\/feedops\/\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Tracking Google Free Shopping Clicks In Google Analytics","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/feedops.com\/tracking-google-free-shopping-clicks-in-google-analytics\/","og_locale":"en_US","og_type":"article","og_title":"Tracking Google Free Shopping Clicks In Google Analytics","og_description":"As you may have heard, Google released free shopping listings on the Google Shopping Tab last year in October. These \u00a0free listings are available to all e-commerce retailers who have an approved Google Merchant Center and Google Shopping Feed. They appear in the Google results at no cost to the advertiser. Paid ads will continue [&hellip;]","og_url":"https:\/\/feedops.com\/tracking-google-free-shopping-clicks-in-google-analytics\/","og_site_name":"FeedOps","article_publisher":"https:\/\/www.facebook.com\/feedops","article_published_time":"2021-02-16T14:30:22+00:00","article_modified_time":"2022-08-10T09:52:01+00:00","og_image":[{"width":1920,"height":1440,"url":"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60e3b7cf6b36f0a2341dc868_analytics-3680198_1920-1.png","type":"image\/png"}],"author":"FeedOps","twitter_card":"summary_large_image","twitter_misc":{"Written by":"FeedOps","Est. reading time":"3 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/feedops.com\/tracking-google-free-shopping-clicks-in-google-analytics\/#article","isPartOf":{"@id":"https:\/\/feedops.com\/tracking-google-free-shopping-c