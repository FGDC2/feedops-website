d to deliver exceptional value and service to our clients. I am also committed to building and nurturing a talented and diverse team of digital marketers and software developers, who share my vision and values of excellence, collaboration, and customer satisfaction.","sameAs":["http:\/\/www.feedops.com"],"url":"https:\/\/feedops.com\/author\/frank-grasso\/"}]}},"_links":{"self":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/posts\/1930","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/users\/9"}],"replies":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/comments?post=1930"}],"version-history":[{"count":0,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/posts\/1930\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/media\/1989"}],"wp:attachment":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/media?parent=1930"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/categories?post=1930"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/tags?post=1930"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}