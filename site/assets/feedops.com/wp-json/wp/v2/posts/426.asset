ect\",\"inLanguage\":\"en-US\",\"@id\":\"https:\/\/feedops.com\/#\/schema\/logo\/image\/\",\"url\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png\",\"contentUrl\":\"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png\",\"width\":899,\"height\":929,\"caption\":\"FeedOps\"},\"image\":{\"@id\":\"https:\/\/feedops.com\/#\/schema\/logo\/image\/\"},\"sameAs\":[\"https:\/\/www.facebook.com\/feedops\",\"https:\/\/www.linkedin.com\/company\/feedops\/\",\"https:\/\/www.youtube.com\/@feedops\"]},{\"@type\":\"Person\",\"@id\":\"https:\/\/feedops.com\/#\/schema\/person\/9eea0f62fd882d504a8249203da9b798\",\"name\":\"FeedOps\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\/\/feedops.com\/#\/schema\/person\/image\/\",\"url\":\"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g\",\"contentUrl\":\"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g\",\"caption\":\"FeedOps\"},\"sameAs\":[\"https:\/\/feedops.com\"],\"url\":\"https:\/\/feedops.com\/author\/feedops\/\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Google Ads Extensions: What Are The Types And How Do I Automate Them?","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/feedops.com\/google-ads-extensions-what-are-the-types-and-how-to-automate-them\/","og_locale":"en_US","og_type":"article","og_title":"Google Ads Extensions: What Are The Types And How Do I Automate Them?","og_description":"Google Ad extensions are a way to expand your text ad with additional information. According to Google, they typically increase your ad\u00e2\u0080\u0099s click through rate (CTR) and give your ad g