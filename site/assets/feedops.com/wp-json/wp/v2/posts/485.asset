ing-campaign\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/feedops.com\/"},{"@type":"ListItem","position":2,"name":"What is a Google Smart Shopping Campaign?"}]},{"@type":"WebSite","@id":"https:\/\/feedops.com\/#website","url":"https:\/\/feedops.com\/","name":"FeedOps","description":"","publisher":{"@id":"https:\/\/feedops.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/feedops.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/feedops.com\/#organization","name":"FeedOps","url":"https:\/\/feedops.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/feedops.com\/#\/schema\/logo\/image\/","url":"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png","contentUrl":"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png","width":899,"height":929,"caption":"FeedOps"},"image":{"@id":"https:\/\/feedops.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/feedops","https:\/\/www.linkedin.com\/company\/feedops\/","https:\/\/www.youtube.com\/@feedops"]},{"@type":"Person","@id":"https:\/\/feedops.com\/#\/schema\/person\/9eea0f62fd882d504a8249203da9b798","name":"FeedOps","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/feedops.com\/#\/schema\/person\/image\/","url":"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g","caption":"FeedOps"},"sameAs":["https:\/\/feedops.com"],"url":"https:\/\/feedops.com\/author\/feedops\/"}]}},"_links":{"self":[{"href":"https