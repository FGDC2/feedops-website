image\/","url":"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/c2b0f27e50dc69841cab5842197e5f7df0361e6d21a6e1a92810442ca0c467eb?s=96&d=mm&r=g","caption":"FeedOps"},"sameAs":["https:\/\/feedops.com"],"url":"https:\/\/feedops.com\/author\/feedops\/"}]}},"_links":{"self":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/posts\/438","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/comments?post=438"}],"version-history":[{"count":0,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/posts\/438\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/media\/439"}],"wp:attachment":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/media?parent=438"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/categories?post=438"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/tags?post=438"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}