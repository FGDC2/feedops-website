e-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/feedops.com\/what-are-google-smart-shopping-campaigns\/","og_locale":"en_US","og_type":"article","og_title":"What Are Google Smart Shopping Campaigns?","og_description":"Standard Google Shopping ads allow you to show product ads at the top of Google search results for terms relevant to your products. Smart Shopping campaigns use automated bidding and placements to improve upon the results of standard Google Shopping Campaigns. If you need help with your Google Smart Shopping ads we have Google Shopping [&hellip;]","og_url":"https:\/\/feedops.com\/what-are-google-smart-shopping-campaigns\/","og_site_name":"FeedOps","article_publisher":"https:\/\/www.facebook.com\/feedops","article_published_time":"2019-10-16T14:30:29+00:00","article_modified_time":"2022-08-10T07:30:41+00:00","og_image":[{"width":945,"height":536,"url":"https:\/\/feedops.com\/wp-content\/uploads\/2022\/08\/60f0df0a53742c58e32835f2_elementor-compatible.png","type":"image\/png"}],"author":"FeedOps","twitter_card":"summary_large_image","twitter_misc":{"Written by":"FeedOps","Est. reading time":"6 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/feedops.com\/what-are-google-smart-shopping-campaigns\/#article","isPartOf":{"@id":"https:\/\/feedops.com\/what-are-google-smart-shopping-campaigns\/"},"author":{"name":"FeedOps","@id":"https:\/\/feedops.com\/#\/schema\/person\/9eea0f62fd882d504a8249203da9b798"},"headline":"What Are Google Smart Shopping Campaigns?","datePublished":"2019-10-16T14:30:29+00:00","dateModified":"2022-08-10T07:30:41+00:00","mainEntityOfPage":{"@id":"https:\/\/feedops.com\/what-are-google-smart-shopping-campaigns\/"},"wordCount":1255,"publisher":{"@id":"https:\/\/feedops.com\/#organization"},"image":{"@id":"https:\/\/feedops.com\/what-are-google-smart-shopping-campaigns\/#primaryimage"},"thumbnailUrl":"https:\/\/feedops.com\/wp-conten