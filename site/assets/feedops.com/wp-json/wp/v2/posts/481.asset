/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/media\/482"}],"wp:attachment":[{"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/media?parent=481"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/categories?post=481"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/feedops.com\/wp-json\/wp\/v2\/tags?post=481"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}