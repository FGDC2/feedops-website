pe":"WebPage","@id":"https:\/\/feedops.com\/privacy-policy\/","url":"https:\/\/feedops.com\/privacy-policy\/","name":"Privacy Policy - FeedOps","isPartOf":{"@id":"https:\/\/feedops.com\/#website"},"datePublished":"2022-12-05T08:39:27+00:00","dateModified":"2025-11-03T22:27:26+00:00","description":"Learn how FeedOps protects your personal data with strong encryption, limited retention, and full compliance with Google and Amazon.","breadcrumb":{"@id":"https:\/\/feedops.com\/privacy-policy\/#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/feedops.com\/privacy-policy\/"]}]},{"@type":"BreadcrumbList","@id":"https:\/\/feedops.com\/privacy-policy\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/feedops.com\/"},{"@type":"ListItem","position":2,"name":"Privacy Policy"}]},{"@type":"WebSite","@id":"https:\/\/feedops.com\/#website","url":"https:\/\/feedops.com\/","name":"FeedOps","description":"","publisher":{"@id":"https:\/\/feedops.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/feedops.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/feedops.com\/#organization","name":"FeedOps","url":"https:\/\/feedops.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/feedops.com\/#\/schema\/logo\/image\/","url":"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png","contentUrl":"https:\/\/feedops.com\/wp-content\/uploads\/2022\/05\/Feedops-staggered-logo_Final-2-e1653522818889.png","width":899,"height":929,"caption":"FeedOps"},"image":{"@id":"https:\/\/feedops.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/feedops","https:\/\/www.linkedin.com\/company\/feedops\/","https:\/\/w