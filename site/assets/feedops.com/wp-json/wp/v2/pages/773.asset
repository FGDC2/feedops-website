0d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ba9fb06 elementor-widget elementor-widget-image\" data-id=\"ba9fb06\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"200\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/rqmedia_logo.jpeg\" class=\"attachment-full size-full wp-image-4817\" alt=\"\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/rqmedia_logo.jpeg 200w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/rqmedia_logo-150x150.jpeg 150w\" sizes=\"(max-width: 200px) 100vw, 200px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3658c41 elementor-widget elementor-widget-image\" data-id=\"3658c41\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"480\" height=\"92\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/LocaliQ_new_logo.jpg\" class=\"attachment-full size-full wp-image-4813\" alt=\"\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/LocaliQ_new_logo.jpg 480w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/LocaliQ_new_logo-300x58.jpg 300w\" sizes=\"(max-width: 480px) 100vw, 480px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b745de8 elementor-widget elementor-widget-image\" data-id=\"b745de8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"168\" height=\"68\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/07\/thryv-main-logo-color-au.png\" class=\"attachment-full size-full wp-image-4814\" alt=\"\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-52d0501 e-flex e-con-boxed e-con e-parent\" data-id=\"52d0501\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6502e80 elementor-pagination-type-bullets elementor-arrows-position-inside elementor-pagination-position-outside elementor-widget elementor-widget-n-carousel\" data-id=\"6502e80\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;carousel_items&quot;:[{&quot;slide_title&quot;:&quot;\\u00a0- Taylor Murray - Head of Digital Transformation - Amart&quot;,&quot;_id&quot;:&quot;c547ead&quot;},{&quot;slide_title&quot;:&quot;RQMedia&quot;,&quot;_id&quot;:&quot;c7032d0&quot;},{&quot;slide_title&quot;:&quot;Kristy Thomas&quot;,&quot;_id&quot;:&quot;5b4408c&quot;},{&quot;slide_title&quot;:&quot;Karim Saykali, WeBrandIt.co.uk&quot;,&quot;_id&quot;:&quot;9a79223&quot;}],&quot;slides_to_show&quot;:&quot;1&quot;,&quot;slides_to_show_tablet&quot;:&quot;2&quot;,&quot;slides_to_show_mobile&quot;:&quot;1&quot;,&quot;autoplay&quot;:&quot;yes&quot;,&quot;autoplay_speed&quot;:5000,&quot;pause_on_hover&quot;:&quot;yes&quot;,&quot;pause_on_interaction&quot;:&quot;yes&quot;,&quot;infinite&quot;:&quot;yes&quot;,&quot;speed&quot;:500,&quot;offset_sides&quot;:&quot;none&quot;,&quot;arrows&quot;:&quot;yes&quot;,&quot;pagination&quot;:&quot;bullets&quot;,&quot;image_spacing_custom&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:10,&quot;sizes&quot;:[]},&quot;image_spacing_custom_laptop&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;image_spacing_custom_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;image_spacing_custom_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]}}\" data-widget_type=\"nested-carousel.default\">\n\t\t\t\t\t\t\t<div class=\"e-n-carousel swiper\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Carousel\" dir=\"ltr\">\n\t\t\t<div class=\"swiper-wrapper\" aria-live=\"off\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"1\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"1 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-459658a e-flex e-con-boxed e-con e-child\" data-id=\"459658a\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-bfabad4 elementor-widget elementor-widget-heading\" data-id=\"bfabad4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\"FeedOps AI title optimisation delivered outstanding results in just 5 weeks\u2014organic clicks nearly doubled (+96.57%) on optimised SKUs and rose 51.16% even on non-AI titles. The AI outperformed our manual templates, proving they are a critical tool for driving organic growth without extra budget. The FeedOps team\u2019s expert guidance made implementation straightforward and seamless, and we\u2019re now rolling it out across our full catalogue to maximise results.\"<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-8ad865e e-con-full e-flex e-con e-child\" data-id=\"8ad865e\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-1283478 e-con-full e-flex e-con e-child\" data-id=\"1283478\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-b83c4fe elementor-widget elementor-widget-image\" data-id=\"b83c4fe\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"400\" height=\"400\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart-.png\" class=\"attachment-large size-large wp-image-5183\" alt=\"Taylor Murray - Head of Digital Transformation - Amart\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart-.png 400w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart--300x300.png 300w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Taylor-Murray-Head-of-Digital-Transformation-Amart--150x150.png 150w\" sizes=\"(max-width: 400px) 100vw, 400px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-cab4f15 elementor-widget-laptop__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"cab4f15\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u00a0&#8211; Taylor Murray\u00a0<\/i><\/strong><\/span><\/p><p><strong><i> Head of Digital Transformation, Amart<\/i><\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"2\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"2 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a8d0551 e-flex e-con-boxed e-con e-child\" data-id=\"a8d0551\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-709ed12 elementor-widget elementor-widget-heading\" data-id=\"709ed12\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\u201cAfter using FeedOps\u2019 Natural Language Titles on Speedo Australia, non-branded search terms rose 33%, impressions jumped 18%, and clicks increased 11%.\u201d<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-3737a0d e-con-full e-flex e-con e-child\" data-id=\"3737a0d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-066b6a7 e-con-full e-flex e-con e-child\" data-id=\"066b6a7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-c83c1a1 elementor-widget elementor-widget-image\" data-id=\"c83c1a1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"1000\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2.webp\" class=\"attachment-large size-large wp-image-5132\" alt=\"Hamish Becker, Account Director, RQMedia\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2.webp 800w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2-240x300.webp 240w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/65ea9f6d3b00b779dadb5861_Hamish-Becker-2-768x960.webp 768w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8485bb7 elementor-widget elementor-widget-text-editor\" data-id=\"8485bb7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u2013 Hamish Becker<\/i><\/strong><\/span><\/p><p><strong><i> Account Director, RQMedia<\/i><\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"3\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"3 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-253a96d e-flex e-con-boxed e-con e-child\" data-id=\"253a96d\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-67665d1 elementor-widget elementor-widget-heading\" data-id=\"67665d1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\"Since onboarding FeedOps, we've seen a huge lift in Organic Shopping performance. In just one month, revenue from this channel jumped by 139%. I\u2019m excited to see how far we can take this.\"<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-b8c550f e-con-full e-flex e-con e-child\" data-id=\"b8c550f\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-2d590a4 e-con-full e-flex e-con e-child\" data-id=\"2d590a4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5c5193e elementor-widget elementor-widget-image\" data-id=\"5c5193e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"200\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Kristy-Thomas-Head-of-Marketing-Customer-Engagement-.jpeg\" class=\"attachment-large size-large wp-image-5134\" alt=\"Kristy Thomas Head of Marketing &amp; Customer Engagement\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Kristy-Thomas-Head-of-Marketing-Customer-Engagement-.jpeg 200w, https:\/\/feedops.com\/wp-content\/uploads\/2025\/08\/Kristy-Thomas-Head-of-Marketing-Customer-Engagement--150x150.jpeg 150w\" sizes=\"(max-width: 200px) 100vw, 200px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-6844559 elementor-widget-laptop__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"6844559\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u00a0&#8211; Kristy Thomas<\/i><\/strong><\/span><\/p><p><strong><i> Head of Marketing &amp; Customer Engagement, Auto One<\/i><\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" data-slide=\"4\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"4 of 4\">\n\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-7fc24b7 e-flex e-con-boxed e-con e-child\" data-id=\"7fc24b7\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8b165b1 elementor-widget elementor-widget-heading\" data-id=\"8b165b1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">\u201cFeedOps didn\u2019t just optimise our product data \u2014 they helped us align it with our Google Ads strategy. Within a week, we saw a 400% increase in conversions. The impact was immediate and measurable.\u201d<\/h3>\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-3541cb7 e-con-full e-flex e-con e-child\" data-id=\"3541cb7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-45cad1b e-con-full e-flex e-con e-child\" data-id=\"45cad1b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-77e4f1d elementor-widget elementor-widget-image\" data-id=\"77e4f1d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"190\" height=\"190\" src=\"https:\/\/feedops.com\/wp-content\/uploads\/2026\/04\/Karim-Saykali.jpeg\" class=\"attachment-large size-large wp-image-5742\" alt=\"\" srcset=\"https:\/\/feedops.com\/wp-content\/uploads\/2026\/04\/Karim-Saykali.jpeg 190w, https:\/\/feedops.com\/wp-content\/uploads\/2026\/04\/Karim-Saykali-150x150.jpeg 150w\" sizes=\"(max-width: 190px) 100vw, 190px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-01934c6 elementor-widget-laptop__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"01934c6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #000000;\"><strong><i>\u00a0&#8211; Karim Saykali,<\/i><\/strong><\/span><\/p><p><span style=\"color: #000000;\"><strong><i>WeBrandIt.co.uk<\/i><\/strong><\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-prev\" role=\"button\" tabindex=\"0\" aria-label=\"Previous\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-left\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L6