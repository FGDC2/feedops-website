                var images = new Array()
                function preload() {
                    for (i = 0; i < preload.arguments.length; i++) {
                        images[i] = new Image()
                        images[i].src = preload.arguments[i]
                    }
                }
                preload("https://feedops.com/wp-content/uploads/2023/03/FeedOps-Product-Feed-Management-Software.png"
)
